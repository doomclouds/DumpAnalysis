<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DumpAnalysis</RootNamespace>
    <AssemblyName>DumpAnalysis</AssemblyName>
    <!-- Console apps default to Workstation GC; keep it explicit so dumps are predictable. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Portable PDB is required so SOS can resolve method/field names in the dump. -->
    <DebugType>portable</DebugType>
    <!-- Scenario 05 touches native pages through a byte*. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
